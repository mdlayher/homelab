#!/usr/bin/env bash
# Builds the Windows PCs' configuration from this flake and applies it over
# SSH.
#
# Usage: windows/deploy [--check] <host>|--all
#
# --check prints how a machine differs from the build and changes nothing,
# exiting 1 if any does. host is a machine in windows/hosts.nix, reached at
# its tailnet name; --all is every one of them, skipping any that are off,
# and with a single machine in hosts.nix host may be left out. Each
# machine's connections share one multiplexed SSH session, so a deploy is
# one touch of the admin's FIDO2 key per machine.
#
# HWiNFO's license key comes from windows/secrets.yaml, which decrypts
# without the gate.
set -euo pipefail

check=()
if [[ ${1:-} == --check ]]; then
  check=(-Check)
  shift
fi

# Flakes may not be enabled in the local nix.conf (e.g. on a non-NixOS host).
export NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG
}experimental-features = nix-command flakes"

cd "$(dirname "$0")/.."
mapfile -t all < <(nix eval --json --file windows/hosts.nix hosts | jq -r '.[]')
if [[ $# -eq 0 && ${#all[@]} -eq 1 ]]; then
  set -- --all
fi
if [[ $# -ne 1 ]]; then
  echo "usage: $0 [--check] <host>|--all" >&2
  exit 2
fi
if [[ $1 == --all ]]; then
  hosts=("${all[@]}")
else
  hosts=("$1")
fi
out=$(nix build --no-link --print-out-paths .#windows)

# Provenance (see lib/deploy.sh). Windows ships no logs, so the lines go to
# Loki directly, and a finished deploy is announced in the Discord ops
# channel. A check changes nothing, and logs and announces nothing.
source lib/deploy.sh
log() {
  [[ ${#check[@]} -eq 0 ]] || return 0
  deploy_loki "$@"
}

# The license key joins the build's files outside the Nix store, which any
# user can read.
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
cp -r "$out"/. "$stage"
chmod -R u+w "$stage"
sops -d --extract '["hwinfo_key"]' windows/secrets.yaml >"$stage/HWiNFO64_KEY.txt"

# Uploaded to a directory the deploy recreates each time and removes after.
dir='C:\ProgramData\homelab-deploy'
status=0
for name in "${hosts[@]}"; do
  host="mdlayher@$name.taild07ab.ts.net"
  echo "== $name"
  if ! timeout 5 bash -c "exec 3<>/dev/tcp/$name.taild07ab.ts.net/22" 2>/dev/null; then
    echo "unreachable, skipped"
    continue
  fi
  log "$name" "$(deploy_line apply starting)"
  ssh "$host" "Remove-Item -Recurse -Force '$dir' -ErrorAction SilentlyContinue; New-Item -ItemType Directory '$dir' | Out-Null"
  scp -q "$stage"/* "$host:/C:/ProgramData/homelab-deploy/"
  applied=0
  ssh "$host" "powershell -NoProfile -ExecutionPolicy Bypass -File '$dir\\apply.ps1' ${check[*]:-}" || applied=$?
  ssh "$host" "Remove-Item -Recurse -Force '$dir'"
  if [[ $applied -eq 0 ]]; then
    log "$name" "$(deploy_line apply finished)"
    [[ ${#check[@]} -gt 0 ]] || deploy_notify "$name" "windows/"
  else
    log "$name" "$(deploy_line apply failed "status=$applied")"
    status=1
  fi
done
exit "$status"
