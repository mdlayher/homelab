#!/usr/bin/env bash
# Builds the LG TVs' configuration from this flake and applies it over SSH.
#
# Usage: lgtv/deploy [--check] <host>|--all
#
# --check prints how a TV differs from the build and changes nothing,
# exiting 1 if any does. host is a TV in lgtv/hosts.nix, reached at its
# inventory name; --all is every one of them, and with a single TV host may
# be left out. Each TV is one connection, so a deploy is one touch of the
# admin's FIDO2 key per TV.
set -euo pipefail

check=()
if [[ ${1:-} == --check ]]; then
  check=(--check)
  shift
fi

# Flakes may not be enabled in the local nix.conf (e.g. on a non-NixOS host).
export NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG
}experimental-features = nix-command flakes"

cd "$(dirname "$0")/.."
mapfile -t all < <(nix eval --json --file lgtv/hosts.nix hosts | jq -r '.[]')
if [[ $# -eq 0 && ${#all[@]} -eq 1 ]]; then
  set -- --all
fi
if [[ $# -ne 1 ]]; then
  echo "usage: $0 [--check] <host>|--all" >&2
  exit 2
fi
if [[ $1 == --all ]]; then
  hosts=("${all[@]}")
else
  hosts=("$1")
fi
out=$(nix build --no-link --print-out-paths .#lgtv)

# Glasshouse's token travels beside the built tree rather than in it, so it
# never enters the Nix store. lgtv/secrets.yaml decrypts without the gate.
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
(umask 077 && sops -d --extract '["glasshouse_token"]' lgtv/secrets.yaml >"$stage/token")

# Provenance (see lib/deploy.sh). The TVs ship no logs, so the lines go to
# Loki directly, and a finished deploy is announced in the Discord ops
# channel. A check changes nothing, and logs and announces nothing.
source lib/deploy.sh
log() {
  [[ ${#check[@]} -eq 0 ]] || return 0
  deploy_loki "$@"
}

failed=0
for host in "${hosts[@]}"; do
  if [[ ! -d $out/$host ]]; then
    echo "$host: not in lgtv/hosts.nix" >&2
    failed=1
    continue
  fi
  echo "== $host"
  log "$host" "$(deploy_line apply starting)"
  # One connection uploads and applies, so a deploy is one touch with no
  # control socket left behind. /tmp is a tmpfs on webOS. The TVs' dropbear
  # has no post-quantum key exchange, so ssh's warning about it is noise.
  status=0
  tar -chf - -C "$out/$host" . -C "$stage" token | ssh -o ControlMaster=no -o ControlPath=none -o WarnWeakCrypto=no "root@$(<"$out/$host/fqdn")" "
    rm -rf /tmp/lgtv-deploy && mkdir -m 0700 /tmp/lgtv-deploy && tar -C /tmp/lgtv-deploy -xf - &&
      sh /tmp/lgtv-deploy/apply.sh ${check[*]:-}" || status=$?
  if [[ $status -eq 0 ]]; then
    log "$host" "$(deploy_line apply finished)"
    [[ ${#check[@]} -gt 0 ]] || deploy_notify "$host" "lgtv/"
  else
    log "$host" "$(deploy_line apply failed) status=$status"
    failed=1
  fi
done
exit "$failed"
