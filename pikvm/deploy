#!/usr/bin/env bash
# Builds the KVM's configuration from this flake and applies it over SSH.
#
# Usage: pikvm/deploy [--check] [host]
#
# --check prints how the device differs from the build and changes nothing,
# exiting 1 if it does. host defaults to the KVM's tailnet name. Logins from
# the development container require the admin's FIDO2 key, and a run is a
# single connection, so a deploy is one touch.
set -euo pipefail

check=()
if [[ ${1:-} == --check ]]; then
  check=(--check)
  shift
fi
host=${1:-pikvm.taild07ab.ts.net}

# Flakes may not be enabled in the local nix.conf (e.g. on a non-NixOS host).
export NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG
}experimental-features = nix-command flakes"

cd "$(dirname "$0")/.."
out=$(nix build --no-link --print-out-paths .#pikvm)

# One connection uploads and applies, so a deploy is one touch with no
# control socket left behind. /tmp is a tmpfs on PiKVM OS, so unpacking
# there needs no rw; apply.sh reads nothing from stdin.
tar -C "$out" -chf - . | ssh -o ControlMaster=no -o ControlPath=none "root@$host" \
  "rm -rf /tmp/pikvm-deploy && mkdir -m 0700 /tmp/pikvm-deploy && tar -C /tmp/pikvm-deploy -xf - && exec bash /tmp/pikvm-deploy/apply.sh ${check[*]:-}"
