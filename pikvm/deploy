#!/usr/bin/env bash
# Builds the KVM's configuration from this flake and applies it over SSH.
#
# Usage: pikvm/deploy [--check] <host>|--all
#
# --check prints how the device differs from the build and changes nothing,
# exiting 1 if it does. host is the KVM's name, reached at its tailnet name;
# --all is every KVM, and with a single KVM host may be left out. Logins
# from the development container require the admin's FIDO2 key, and a run
# is a single connection, so a deploy is one touch.
set -euo pipefail

check=()
if [[ ${1:-} == --check ]]; then
  check=(--check)
  shift
fi
# The KVMs this deploys; one, so --all and no host both mean it.
kvms=(pikvm)
if [[ $# -eq 0 && ${#kvms[@]} -eq 1 ]]; then
  set -- --all
fi
if [[ $# -ne 1 ]]; then
  echo "usage: $0 [--check] <host>|--all" >&2
  exit 2
fi
if [[ $1 == --all ]]; then
  name=${kvms[0]}
else
  name=$1
fi
host="$name.taild07ab.ts.net"

# Flakes may not be enabled in the local nix.conf (e.g. on a non-NixOS host).
export NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG
}experimental-features = nix-command flakes"

cd "$(dirname "$0")/.."
out=$(nix build --no-link --print-out-paths .#pikvm)

# Provenance for the device's journal (see lib/deploy.sh), which its Alloy
# ships to Loki under {unit="deploy"}, and a finished deploy announced in the
# Discord ops channel. A check changes nothing, and logs and announces
# nothing.
source lib/deploy.sh
logs=(: : :)
if [[ ${#check[@]} -eq 0 ]]; then
  logs=(
    "logger -t deploy -- \"$(deploy_line apply starting)\""
    "logger -t deploy -- \"$(deploy_line apply finished)\""
    "logger -t deploy -- \"$(deploy_line apply failed) status=\$status\""
  )
fi

# One connection carries the deploy, so it is one touch with no control
# socket left behind. The device first names the manifest's files it lacks
# or holds with another checksum or mode (apply.sh --wanted), and only
# those cross the tailnet, so a deploy moves kilobytes until a binary's
# version changes. Each archive is sent behind its byte count, which is
# how far the device reads before the next step. /tmp is a tmpfs on PiKVM
# OS, so unpacking there needs no rw.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
status=0
coproc remote { ssh -o ControlMaster=no -o ControlPath=none "root@$host" "
  ${logs[0]}
  status=0
  { rm -rf /tmp/pikvm-deploy && mkdir -m 0700 /tmp/pikvm-deploy && cd /tmp/pikvm-deploy &&
    read -r n && head -c \"\$n\" | tar -xf - && bash apply.sh --wanted &&
    read -r n && head -c \"\$n\" | tar -xf - && bash apply.sh ${check[*]:-}; } || status=\$?
  if [ \$status -eq 0 ]; then ${logs[1]}; else ${logs[2]}; fi
  exit \$status"; }
pid=$remote_PID
exec {in}>&"${remote[1]}" {out_fd}<&"${remote[0]}"
send() {
  wc -c <"$1" >&"$in"
  cat "$1" >&"$in"
}

tar -C "$out" -chf "$tmp/build.tar" apply.sh manifest packages sums
send "$tmp/build.tar"

# The device's answer, each line "wanted <path>", closed by "wanted end".
# Anything else it prints passes through. The manifest rides along so the
# archive is never empty.
: >"$tmp/wanted"
answered=no
while read -r line <&"$out_fd"; do
  case $line in
  "wanted end")
    answered=yes
    break
    ;;
  "wanted "*) echo "tree${line#wanted }" >>"$tmp/wanted" ;;
  *) echo "$line" ;;
  esac
done
if [[ $answered == yes ]]; then
  tar -C "$out" -chf "$tmp/files.tar" -T "$tmp/wanted" manifest
  send "$tmp/files.tar"
fi
exec {in}>&-
cat <&"$out_fd"
wait "$pid" || status=$?
if [[ $status -eq 0 && ${#check[@]} -eq 0 ]]; then
  deploy_notify "$name" "pikvm/"
fi
exit "$status"
