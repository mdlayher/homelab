#!/usr/bin/env bash
# ModemManager's signal readings for node_exporter's textfile collector: a
# port of OpenWrt's prometheus-node-exporter-lua-modemmanager collector
# (see openwrt/), with its metric names and labels, so the same queries
# cover both. A reading ModemManager does not have is left out, and a modem
# that is gone takes its series with it. The detailed readings need a
# signal refresh rate, set when the connection comes up (see default.nix).
set -uo pipefail

dir=/run/prometheus-node-exporter/textfile
tmp=$(mktemp "$dir/.modemmanager.XXXXXX")
trap 'rm -f "$tmp"' EXIT

for modem in $(mmcli -L -K 2>/dev/null | awk -F' *: *' '$1 ~ /^modem-list\.value/ { print $2 }'); do
  # mmcli's key-value output: "key : value", the key padded with spaces.
  # The collector names a reading modemmanager_signal_<tech>_<field>, with
  # a field's dashes made underscores so the name stays valid.
  {
    mmcli -m "$modem" -K 2>/dev/null
    mmcli -m "$modem" --signal-get -K 2>/dev/null
  } | awk -F' *: *' -v m="$modem" '
    $1 == "modem.generic.signal-quality.value" && $2 ~ /^[0-9]+$/ {
      printf "modemmanager_signal_quality{modem=\"%s\"} %s\n", m, $2
    }
    $1 ~ /^modem\.signal\./ && $2 ~ /^-?[0-9.]+$/ {
      name = substr($1, length("modem.signal.") + 1)
      gsub(/[.-]/, "_", name)
      printf "modemmanager_signal_%s{modem=\"%s\"} %s\n", name, m, $2
    }'
done >"$tmp"

chmod 644 "$tmp"
mv "$tmp" "$dir/modemmanager.prom"
