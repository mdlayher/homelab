{
  "uid": "unifi-client",
  "title": "UniFi client",
  "description": "One client from the UniFi controller, selected by its name: the client variable in Grafana, `grom-dash unifi-client client=<name>` in grom. The controller's transmit counters are traffic toward the client. Radio panels show data for wireless clients only.",
  "tags": [
    "unifi"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "client",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(unpoller_client_uptime_seconds, name)",
        "query": {
          "query": "label_values(unpoller_client_uptime_seconds, name)",
          "refId": "client"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "living-room-lgcx",
          "value": "living-room-lgcx"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "connected for",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(unpoller_client_uptime_seconds{name=\"$client\"})"
        }
      ],
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "signal dBm",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": -75
              },
              {
                "color": "green",
                "value": -65
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(unpoller_client_radio_signal_db{name=\"$client\"})"
        }
      ],
      "options": {
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "satisfaction",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(unpoller_client_satisfaction_ratio{name=\"$client\"})"
        }
      ],
      "options": {
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "roams, 24h",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(unpoller_client_roam_count_total{name=\"$client\"}[24h]))) or vector(0)"
        }
      ],
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "attached to, for",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (ap_name, channel) (unpoller_client_uptime_seconds{name=\"$client\", wired=\"false\"})",
          "legendFormat": "{{ap_name}} ch {{channel}}",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (sw_name, sw_port) (unpoller_client_uptime_seconds{name=\"$client\", wired=\"true\"})",
          "legendFormat": "{{sw_name}} port {{sw_port}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "traffic Mbit/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbit/s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(unpoller_client_receive_bytes_total{name=\"$client\"}[5m]) * 8 / 1e6)",
          "legendFormat": "from client"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(unpoller_client_transmit_bytes_total{name=\"$client\"}[5m]) * 8 / 1e6)",
          "legendFormat": "to client"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "signal and noise dBm",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (ap_name) (unpoller_client_radio_signal_db{name=\"$client\"})",
          "legendFormat": "signal {{ap_name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (ap_name) (unpoller_client_noise_db{name=\"$client\"})",
          "legendFormat": "noise {{ap_name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "link rate Mbit/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbit/s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(unpoller_client_radio_receive_rate_bps{name=\"$client\"}) / 1e6",
          "legendFormat": "from client"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(unpoller_client_radio_transmit_rate_bps{name=\"$client\"}) / 1e6",
          "legendFormat": "to client"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "transmit retries, share of packets",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(unpoller_client_transmit_retries_total{name=\"$client\"}[15m])) / sum(rate(unpoller_client_transmit_packets_total{name=\"$client\"}[15m]))",
          "legendFormat": "retries"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "roams per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(unpoller_client_roam_count_total{name=\"$client\"}[1h]))",
          "legendFormat": "roams"
        }
      ]
    }
  ]
}
