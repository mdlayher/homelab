{
  "uid": "bgp",
  "title": "BGP",
  "description": "BIRD on each dn42 node: the external dn42e_ peers, the ibgp_ mesh between the nodes' loopbacks, and the RPKI feeds. The lab link dn42i_dev0 is left out. Prefix and update counts are summed over both address families.",
  "tags": [
    "bgp",
    "dn42"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "sessions down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (instance, name, ip_version) (bird_protocol_up{proto=\"BGP\", name!=\"dn42i_dev0\"}) == 0) or vector(0)"
        }
      ],
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RPKI feeds down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (instance, name) (bird_protocol_up{proto=\"RPKI\"}) unless on (instance, name) bird_protocol_up{proto=\"RPKI\", state=\"Established\"}) or vector(0)"
        }
      ],
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "changes, 24h",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(changes((max by (instance, name, ip_version) (bird_protocol_up{proto=\"BGP\", name!=\"dn42i_dev0\"}))[24h:1m]))"
        }
      ],
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "peers unreachable",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(dn42_peer_up == 0) or vector(0)"
        }
      ],
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "external sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(max by (site, name, ip_version) (bird_protocol_up{proto=\"BGP\", name=~\"dn42e_.*\"}), \"peer\", \"$1\", \"name\", \"(?:dn42e|ibgp)_(.+)\")",
          "legendFormat": "{{peer}} v{{ip_version}} {{site}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "iBGP sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(max by (site, name, ip_version) (bird_protocol_up{proto=\"BGP\", name=~\"ibgp_.*\"}), \"peer\", \"$1\", \"name\", \"(?:dn42e|ibgp)_(.+)\")",
          "legendFormat": "v{{ip_version}} {{site}} {{peer}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "prefixes imported per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (site, name) (bird_protocol_prefix_import_count{proto=\"BGP\", name=~\"dn42e_.*\"}), \"peer\", \"$1\", \"name\", \"(?:dn42e|ibgp)_(.+)\")",
          "legendFormat": "{{peer}} {{site}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "prefixes preferred per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (site, name) (bird_protocol_prefix_preferred_count{proto=\"BGP\", name=~\"dn42e_.*\"}), \"peer\", \"$1\", \"name\", \"(?:dn42e|ibgp)_(.+)\")",
          "legendFormat": "{{peer}} {{site}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "prefixes exported over iBGP",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (site, name) (bird_protocol_prefix_export_count{proto=\"BGP\", name=~\"ibgp_.*\"}), \"peer\", \"$1\", \"name\", \"(?:dn42e|ibgp)_(.+)\")",
          "legendFormat": "{{site}} {{peer}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "updates received per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (site, name) (rate(bird_protocol_changes_update_import_receive_count{proto=\"BGP\", name=~\"dn42e_.*\"}[15m])), \"peer\", \"$1\", \"name\", \"(?:dn42e|ibgp)_(.+)\")",
          "legendFormat": "{{peer}} {{site}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "updates filtered per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (site, name) (rate(bird_protocol_changes_update_import_filter_count{proto=\"BGP\", name=~\"dn42e_.*\"}[15m])), \"peer\", \"$1\", \"name\", \"(?:dn42e|ibgp)_(.+)\")",
          "legendFormat": "{{peer}} {{site}}"
        }
      ],
      "description": "Updates the import filter refused, which includes every announcement that is not ROA-valid."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "peer round trip",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "dn42_peer_rtt_seconds",
          "legendFormat": "{{peer}} {{site}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "tunnel traffic Mbit/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbit/s",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (site, interface) (rate(wireguard_received_bytes_total{interface=~\"dn42e-.*\"}[5m]) * 8 / 1e6 + rate(wireguard_sent_bytes_total{interface=~\"dn42e-.*\"}[5m]) * 8 / 1e6)",
          "legendFormat": "{{interface}} {{site}}"
        }
      ],
      "description": "Received plus sent on each peer's WireGuard tunnel."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "ROAs per feed",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (bird_protocol_prefix_import_count{proto=\"RPKI\"})",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
