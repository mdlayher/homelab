{
  "uid": "isis",
  "title": "IS-IS",
  "description": "The IGP between sites: adjacency and BFD per circuit, what each router holds, and the PDUs and SPF runs behind it. The carrier under each circuit is on the network edge dashboard.",
  "tags": [
    "isis"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "adjacencies down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(homelab_isis_adjacency_up == 0) or vector(0)"
        }
      ],
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "BFD not up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(homelab_isis_adjacency_up == 1 unless on (site, interface) label_replace(frr_bfd_peer_state == 1, \"interface\", \"$1\", \"iface\", \"(.*)\")) or vector(0)"
        }
      ],
      "description": "Adjacencies that are up without an up BFD session, missing or down.",
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "flaps, 24h",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(homelab_isis_adjacency_flaps_total[24h]))"
        }
      ],
      "description": "Every adjacency flap, deploys included.",
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "oldest sample",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(time() - node_textfile_mtime_seconds{file=~\".*/isis[.]prom\"})"
        }
      ],
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "adjacencies",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "homelab_isis_adjacency_up",
          "legendFormat": "{{site}} {{interface}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "BFD sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "frr_bfd_peer_state",
          "legendFormat": "{{site}} {{iface}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "IS-IS routes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(frr_route_rib_count{route_type=\"isis\"}, \"machine\", \"$1\", \"instance\", \"([^.:]+).*\"), \"machine\", \"edge-$1\", \"instance\", \"edge[.]([^.]+)[.].*\")",
          "legendFormat": "{{machine}} {{afi}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LSPs in the database",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(homelab_isis_lsps, \"machine\", \"$1\", \"instance\", \"([^.:]+).*\"), \"machine\", \"edge-$1\", \"instance\", \"edge[.]([^.]+)[.].*\")",
          "legendFormat": "{{machine}} L{{level}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "hellos per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(sum by (instance) (rate(homelab_isis_pdu_rx_total{type=~\".*iih\"}[15m])) * 60, \"machine\", \"$1\", \"instance\", \"([^.:]+).*\"), \"machine\", \"edge-$1\", \"instance\", \"edge[.]([^.]+)[.].*\")",
          "legendFormat": "{{machine}} rx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(sum by (instance) (rate(homelab_isis_pdu_tx_total{type=~\".*iih\"}[15m])) * 60, \"machine\", \"$1\", \"instance\", \"([^.:]+).*\"), \"machine\", \"edge-$1\", \"instance\", \"edge[.]([^.]+)[.].*\")",
          "legendFormat": "{{machine}} tx"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "SPF runs per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(increase(homelab_isis_spf_runs_total[1h]), \"machine\", \"$1\", \"instance\", \"([^.:]+).*\"), \"machine\", \"edge-$1\", \"instance\", \"edge[.]([^.]+)[.].*\")",
          "legendFormat": "{{machine}} L{{level}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "LSPs and SNPs per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(sum by (instance) (rate(homelab_isis_pdu_rx_total{type=~\".*(lsp|snp)\"}[15m])), \"machine\", \"$1\", \"instance\", \"([^.:]+).*\"), \"machine\", \"edge-$1\", \"instance\", \"edge[.]([^.]+)[.].*\")",
          "legendFormat": "{{machine}} rx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(sum by (instance) (rate(homelab_isis_pdu_tx_total{type=~\".*(lsp|snp)\"}[15m])), \"machine\", \"$1\", \"instance\", \"([^.:]+).*\"), \"machine\", \"edge-$1\", \"instance\", \"edge[.]([^.]+)[.].*\")",
          "legendFormat": "{{machine}} tx"
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "BFD session uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "frr_bfd_peer_uptime",
          "legendFormat": "{{site}} {{iface}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    }
  ]
}
