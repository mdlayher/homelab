{
  "uid": "rack-power",
  "title": "Rack power",
  "description": "What the rack draws through the UPS and each PDU, how long the battery would carry it, and the rack's temperature and humidity. Sources: the CyberPower cards (job=\"snmp-cyberpower\") and the server's apcupsd. Only metered PDUs report per-outlet power, and outlets still carrying a default OutletN name are left out. The environment sensor is whichever card reports a non-zero humidity; a card without a probe reports zeros.",
  "tags": [
    "power",
    "cyberpower"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "UPS load",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "upsAdvanceOutputLoad"
        }
      ],
      "options": {
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "battery runtime",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 900
              },
              {
                "color": "green",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "upsAdvanceBatteryRunTimeRemaining / 100"
        }
      ],
      "description": "The UPS card's estimate at the present load. A runtime calibration relearns it.",
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "battery charge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "upsAdvanceBatteryCapacity"
        }
      ],
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "line voltage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "V",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 105
              },
              {
                "color": "red",
                "value": 130
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "upsAdvanceInputLineVoltage / 10"
        }
      ],
      "options": {
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "outlets not on",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ePDU2OutletSwitchedStatusState != 1) or vector(0)"
        }
      ],
      "description": "Switched outlets across the PDUs whose state is anything but on.",
      "options": {
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "draw W",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "W",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "upsAdvanceOutputPower",
          "legendFormat": "UPS output"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(ePDU2DeviceStatusPowerLoad, \"pdu\", \"$1\", \"instance\", \"(?:ipv4[.])?([^.]+)[.].*\")",
          "legendFormat": "{{pdu}}"
        }
      ],
      "description": "The PDU41001 meters in 10 W steps and reads 0 below roughly 10 to 15 W."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "outlet power W",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 14,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "W",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ePDU2OutletMeteredStatusActivePower * on (instance, ePDU2OutletMeteredStatusIndex) group_left (ePDU2OutletMeteredStatusName) ePDU2OutletMeteredStatusName{ePDU2OutletMeteredStatusName!~\"Outlet[0-9]+\"}",
          "legendFormat": "{{ePDU2OutletMeteredStatusName}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "rack temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "°F",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 59
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "envirTemperature / 10 and on (instance) envirHumidity > 0"
        }
      ],
      "options": {
        "graphMode": "area"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "rack humidity",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 20
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "envirHumidity and on (instance) envirHumidity > 0"
        }
      ],
      "options": {
        "graphMode": "area"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "last on battery",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - apcupsd_last_transfer_on_battery_time_seconds"
        }
      ],
      "description": "Time since apcupsd on the server last saw the UPS transfer to battery.",
      "options": {
        "graphMode": "none"
      }
    }
  ]
}
