    {
      "id": 4,
      "type": "bargauge",
      "title": "HDMI links Gbps",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Gbps",
          "max": 48
        },
        "overrides": []
