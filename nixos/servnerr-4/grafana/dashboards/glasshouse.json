{
  "uid": "glasshouse",
  "title": "TVs",
  "description": "The LG OLED TVs, from Glasshouse's native metrics (job=\"glasshouse\"). Every query relabels instance to a short tv label for legends. A TV asleep off the network shows up 0 and its other rows go missing; source, HDMI and frame rate rows exist only with an HDMI source on screen, and an HDMI row only while that input has PHY lock.",
  "tags": [
    "glasshouse"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "TVs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(glasshouse_info, \"tv\", \"$1\", \"instance\", \"([^.]+?)(-lg[a-z0-9]+)?[.].*\")",
          "legendFormat": "{{tv}} {{model}} fw {{firmware}} webOS {{webos}} v{{version}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 2,
      "type": "bargauge",
