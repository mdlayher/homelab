#!/usr/bin/env bash
# Deploys a machine from this flake over SSH.
#
# Usage: nixos/deploy <host>|--all [action] [nix eval args...]
#
# action is one of switch (default), test, boot, or dry-activate. On the
# router, prefer test first: it activates without a boot entry, so a reboot
# reverts it. --all deploys every machine in blast-radius order: the monitor,
# the edge, then the server, then the router.
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: $0 <host>|--all [switch|test|boot|dry-activate] [nix eval args...]" >&2
  exit 2
fi

if [[ $1 == --all ]]; then
  # Ordered by hand, because blast radius is a judgement: the monitor first,
  # then the edges, which have no clients and whose sites hold nothing else,
  # then the server, then the router, which is the network. The edges are in
  # a fixed order rather than a meaningful one: what matters is that a
  # failure on the first stops the run before the second is touched. Checked
  # against the flake below so a machine cannot be left out of --all by
  # omission.
  hosts=(monitnerr-1 edge-iad edge-pdx servnerr-4 routnerr-3)
  all_requested=yes
else
  hosts=("$1")
fi
action=${2:-switch}
shift $(( $# >= 2 ? 2 : 1 ))

# Flakes may not be enabled in the local nix.conf (e.g. on a non-NixOS host).
export NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG
}experimental-features = nix-command flakes"

# Log in as the admin user and escalate with sudo, which authenticates
# against the forwarded FIDO2 keys: a pause during activation is waiting for
# a YubiKey touch. Every privileged step of a deploy runs under one sudo,
# so a deploy is exactly one touch and the machines need no sudo credential
# cache. Without a key at hand, sudo falls through to a password prompt on
# the terminal. Root SSH login is disabled everywhere. Paths built locally
# are unsigned and the user is not trusted on the machines, so build on the
# machine itself: only derivations and sources are copied, and everything
# else comes from the binary cache.
#
# DEPLOY_USER overrides the SSH user if necessary, and DEPLOY_ADDRESS where
# to reach the machine. Both are for a first deploy: a machine built from a
# stock image answers as root, and is not on the tailnet its name resolves
# through until this puts it there. Once deployed it needs neither.
user=${DEPLOY_USER:-mdlayher}

if [[ ${all_requested:-} == yes && -n ${DEPLOY_ADDRESS:-} ]]; then
  echo "error: DEPLOY_ADDRESS names one machine, so it cannot be used with --all" >&2
  exit 2
fi

cd "$(dirname "$0")/.."

# A machine added to the flake and not to the list above would simply never
# be deployed by --all, and nothing would say so: it would drift until the
# nightly upgrade caught it, or until someone noticed its metrics were a
# generation behind. Comparing the two is cheap and fails loudly instead.
if [[ ${all_requested:-} == yes ]]; then
  declared="$(nix eval --raw .#nixosConfigurations \
    --apply 'cfgs: builtins.concatStringsSep "\n" (builtins.attrNames cfgs)')"
  missing="$(comm -23 <(sort <<<"$declared") <(printf '%s\n' "${hosts[@]}" | sort))"
  if [[ -n $missing ]]; then
    echo "error: in the flake but not in --all: $(tr '\n' ' ' <<<"$missing")" >&2
    echo "add it to the hosts list in $0, in blast-radius order" >&2
    exit 1
  fi
fi

# Share the user's SSH connection multiplexer with nix's own store
# connections, which otherwise open (and separately authenticate) their own:
# one live master means one FIDO2 touch covers the whole deploy.
sshopts=(-o ControlMaster=auto -o ControlPath=~/.ssh/cm-%r@%h:%p -o ControlPersist=1h)
export NIX_SSHOPTS="${sshopts[*]}${NIX_SSHOPTS:+ $NIX_SSHOPTS}"

# Provenance for the target's journal: which tree is being deployed, and by
# whom, so a later investigation can tell a deploy (test from a dirty
# checkout included) from a manual change on the machine. Written by the
# unprivileged SSH user through logger, so it costs no extra sudo touch;
# journalctl -t deploy on the machine, or unit="deploy" in Loki, finds
# the lines. Dirtiness follows nix's definition: modified tracked
# files, not untracked ones, which is also what strips the revision from the
# built system. The closing line is best effort: a deploy that succeeded
# and then lost SSH is still a successful deploy.
rev="$(git rev-parse --short=12 HEAD)"
branch="$(git rev-parse --abbrev-ref HEAD)"
if git diff-index --quiet HEAD --; then dirty=no; else dirty=yes; fi
by="$(id -un)@$(hostname -s)"
log() {
  local host=$1 addr=${DEPLOY_ADDRESS:-$1}
  shift
  ssh "${sshopts[@]}" "$user@$addr" logger -t deploy -- "$@"
}

# Build on the machine, then activate under a single sudo. The build is
# what nixos-rebuild does with a build host: evaluate here, copy the
# derivation closure (sources included) over, and realise it there as the
# unprivileged user. Activation runs inside a transient systemd unit, as
# nixos-rebuild also does, so a switch that restarts sshd or networking
# cannot kill itself by dropping this SSH session.
#
# The linuxdev container is never restarted by a host switch so that agent
# sessions inside survive; its new inner configuration is instead activated
# with a reload in the same unit, once the new host system is live (switch
# or test, not boot). Changes to the container scaffolding itself (bind
# mounts, networking, tun) still need a manual restart, which kills
# sessions.
deploy() {
  local host=$1 action=$2 addr=${DEPLOY_ADDRESS:-$1} drv path before count steps script
  shift 2

  # Global, read by the caller's finished line; reset so a failure here
  # cannot report the previous host's count under --all.
  closure="?"

  drv="$(nix eval --raw ".#nixosConfigurations.$host.config.system.build.toplevel.drvPath" "$@")"
  nix copy --to "ssh://$user@$addr" "$drv"
  path="$(ssh "${sshopts[@]}" "$user@$addr" \
    nix --extra-experimental-features nix-command build "$drv^*" --no-link --print-out-paths)"

  # What the deploy moves, which rev= alone never says: the nightly applies
  # main whether or not anything changed. Store paths differing between the
  # running closure and the new one, not `nix store diff-closures`, which
  # reports only name or version moves and so misses an edited unit file.
  # Unprivileged and before activation, so it costs no sudo touch.
  before="$(ssh "${sshopts[@]}" "$user@$addr" readlink -f /run/current-system)"
  count="{ nix-store -qR $before; nix-store -qR $path; } | sort | uniq -u | wc -l"
  closure="$(ssh "${sshopts[@]}" "$user@$addr" /bin/sh -c "$(printf '%q' "$count")")" || closure="?"

  # The transient unit carries systemd's minimal PATH, so name the system
  # profile's binaries by their absolute paths.
  local sw=/run/current-system/sw/bin
  steps=()
  if [[ $action == switch || $action == boot ]]; then
    steps+=("$sw/nix-env -p /nix/var/nix/profiles/system --set $path")
  fi
  steps+=("$path/bin/switch-to-configuration $action")
  if [[ $host == servnerr-4 && ( $action == switch || $action == test ) ]]; then
    steps+=("$sw/systemctl reload container@linuxdev.service")
  fi
  script="$(printf '%s && ' "${steps[@]}")"
  script=${script% && }

  # -t gives sudo a terminal for the touch cue and the password fallback.
  ssh -t "${sshopts[@]}" "$user@$addr" sudo systemd-run \
    --collect --no-ask-password --pipe --quiet --same-dir --wait \
    --service-type=exec --unit=deploy-activate \
    /bin/sh -c "$(printf '%q' "$script")"
}

echo "deploy: a pause at activation may be waiting for a YubiKey touch" >&2
for host in "${hosts[@]}"; do
  echo "deploy: $action $host" >&2
  if [[ $action != dry-activate ]]; then
    log "$host" "$action starting: rev=$rev branch=$branch dirty=$dirty user=$by"
  fi
  status=0
  deploy "$host" "$action" "$@" || status=$?
  if [[ $action != dry-activate ]]; then
    if [[ $status -eq 0 ]]; then
      log "$host" "$action finished: rev=$rev closure=$closure" || echo "deploy: could not log to $host" >&2
    else
      log "$host" "$action failed: rev=$rev status=$status" || echo "deploy: could not log to $host" >&2
    fi
  fi
  if [[ $status -ne 0 ]]; then
    exit "$status"
  fi
done
