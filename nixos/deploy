#!/usr/bin/env bash
# Deploys a machine from this flake over SSH.
#
# Usage: nixos/deploy <host>|--all [action] [nixos-rebuild args...]
#
# action is one of switch (default), test, boot, or dry-activate. On the
# router, prefer test first: it activates without a boot entry, so a reboot
# reverts it. --all deploys every machine in blast-radius order: the monitor,
# then the server, then the router.
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: $0 <host>|--all [switch|test|boot|dry-activate] [nixos-rebuild args...]" >&2
  exit 2
fi

if [[ $1 == --all ]]; then
  hosts=(monitnerr-1 servnerr-4 routnerr-3)
else
  hosts=("$1")
fi
action=${2:-switch}
shift $(( $# >= 2 ? 2 : 1 ))

# Flakes may not be enabled in the local nix.conf (e.g. on a non-NixOS host).
export NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG
}experimental-features = nix-command flakes"

# Log in as the admin user and escalate with sudo, which authenticates
# against the forwarded FIDO2 keys: a pause during activation is waiting for
# a YubiKey touch. Without a key at hand, append --ask-sudo-password for the
# password fallback. Root SSH login is disabled everywhere. Paths built
# locally are unsigned and the user is not trusted on the machines, so build
# on the machine itself: only derivations and sources are copied, and
# everything else comes from the binary cache.
#
# DEPLOY_USER overrides the SSH user if necessary.
user=${DEPLOY_USER:-mdlayher}

cd "$(dirname "$0")/.."

# Share the user's SSH connection multiplexer with nix's own store
# connections, which otherwise open (and separately authenticate) their own:
# one live master means one FIDO2 touch covers the whole deploy.
sshopts=(-o ControlMaster=auto -o ControlPath=~/.ssh/cm-%r@%h:%p -o ControlPersist=1h)
export NIX_SSHOPTS="${sshopts[*]}${NIX_SSHOPTS:+ $NIX_SSHOPTS}"

# Provenance for the target's journal: which tree is being deployed, and by
# whom, so a later investigation can tell a deploy (test from a dirty
# checkout included) from a manual change on the machine. Written by the
# unprivileged SSH user through logger, so it costs no extra sudo touch;
# journalctl -t deploy on the machine, or unit="deploy" in Loki, finds
# the lines. Dirtiness follows nix's definition: modified tracked
# files, not untracked ones, which is also what strips the revision from the
# built system. The closing line is best effort: a deploy that succeeded
# and then lost SSH is still a successful deploy.
rev="$(git rev-parse --short=12 HEAD)"
branch="$(git rev-parse --abbrev-ref HEAD)"
if git diff-index --quiet HEAD --; then dirty=no; else dirty=yes; fi
by="$(id -un)@$(hostname -s)"
log() {
  local host=$1
  shift
  ssh "${sshopts[@]}" "$user@$host" logger -t deploy -- "$@"
}

echo "deploy: a pause at activation may be waiting for a YubiKey touch" >&2
for host in "${hosts[@]}"; do
  echo "deploy: $action $host" >&2
  if [[ $action != dry-activate ]]; then
    log "$host" "$action starting: rev=$rev branch=$branch dirty=$dirty user=$by"
  fi
  status=0
  nix run --inputs-from . nixpkgs#nixos-rebuild-ng -- \
    "$action" --flake ".#$host" \
    --build-host "$user@$host" --target-host "$user@$host" --sudo "$@" || status=$?
  if [[ $action != dry-activate ]]; then
    if [[ $status -eq 0 ]]; then
      log "$host" "$action finished: rev=$rev" || echo "deploy: could not log to $host" >&2
    else
      log "$host" "$action failed: rev=$rev status=$status" || echo "deploy: could not log to $host" >&2
    fi
  fi
  if [[ $status -ne 0 ]]; then
    exit "$status"
  fi

  # The linuxdev container is never restarted by a host switch so that agent
  # sessions inside survive; its new inner configuration is instead activated
  # with a reload once the new host system is live (switch or test, not
  # boot). The reload's sudo rides the brief credential cache from the
  # activation above, so it needs no extra touch. Changes to the container
  # scaffolding itself (bind mounts, networking, tun) still need a manual
  # restart, which kills sessions.
  if [[ $host == servnerr-4 && ( $action == switch || $action == test ) ]]; then
    ssh "${sshopts[@]}" "$user@$host" sudo systemctl reload container@linuxdev.service
  fi
done
