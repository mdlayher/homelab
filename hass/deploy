#!/usr/bin/env bash
# Builds the Home Assistant appliance's configuration from this flake and
# applies it over SSH.
#
# Usage: hass/deploy [--check] <host>|--all
#
# --check prints how the appliance differs from the build and changes
# nothing, exiting 1 if it does. host is the appliance's name, reached at
# its tailnet name as root in the Terminal & SSH add-on; --all is every
# appliance, and with a single appliance host may be left out. Logins from
# the development container require the admin's FIDO2 key, and a run is a
# single connection, so a deploy is one touch.
set -euo pipefail

check=()
if [[ ${1:-} == --check ]]; then
  check=(--check)
  shift
fi
# The appliances this deploys; one, so --all and no host both mean it.
appliances=(hass)
if [[ $# -eq 0 && ${#appliances[@]} -eq 1 ]]; then
  set -- --all
fi
if [[ $# -ne 1 ]]; then
  echo "usage: $0 [--check] <host>|--all" >&2
  exit 2
fi
if [[ $1 == --all ]]; then
  name=${appliances[0]}
else
  name=$1
fi
host="$name.taild07ab.ts.net"

# Flakes may not be enabled in the local nix.conf (e.g. on a non-NixOS host).
export NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG
}experimental-features = nix-command flakes"

cd "$(dirname "$0")/.."
out=$(nix build --no-link --print-out-paths .#hass)

# Provenance (see lib/deploy.sh). The appliance's journal is not the
# machines', so the lines go to Loki directly, and a finished deploy is
# announced in the Discord ops channel. A check changes nothing, and logs
# and announces nothing.
source lib/deploy.sh
log() {
  [[ ${#check[@]} -eq 0 ]] || return 0
  deploy_loki "$@"
}

log "$name" "$(deploy_line apply starting)"
# One connection uploads and applies, so a deploy is one touch with no
# control socket left behind. apply.sh reads nothing from stdin.
status=0
tar -C "$out" -chf - . | ssh -o ControlMaster=no -o ControlPath=none "root@$host" "
  rm -rf /tmp/hass-deploy && mkdir -m 0700 /tmp/hass-deploy && tar -C /tmp/hass-deploy -xf - &&
    bash /tmp/hass-deploy/apply.sh ${check[*]:-}" || status=$?
if [[ $status -eq 0 ]]; then
  log "$name" "$(deploy_line apply finished)"
  [[ ${#check[@]} -gt 0 ]] || deploy_notify "$name" "hass/"
else
  log "$name" "$(deploy_line apply failed) status=$status"
fi
exit "$status"
